# OpenRouter API Key for LLM Slide Draft Generation
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Path to Tesseract OCR Executable (Optional if installed in standard PATH)
# Windows Example: D:\Tesseract-OCR\tesseract.exe or C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=D:\Tesseract-OCR\tesseract.exe
